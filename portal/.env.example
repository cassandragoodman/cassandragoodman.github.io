# Copy this file to .env.local for local testing (vercel dev), and set the same
# names/values in the Vercel project's Environment Variables for production.
# See the setup checklist for where each value comes from.

# OAuth Client ID from Google Cloud Console (Credentials -> OAuth client ID).
# Not a secret — this is also hardcoded in portal/index.html for the sign-in button.
GOOGLE_CLIENT_ID=

# OAuth Client SECRET from the same OAuth client. This IS a secret. Used for the
# server-side flow that lets the portal act as Cassandra when saving to Drive.
GOOGLE_CLIENT_SECRET=

# Long-lived refresh token minted once via /api/oauth-setup, letting the portal
# upload to Cassandra's own Drive (drive.file scope) using her storage quota.
# This IS a secret.
GOOGLE_OAUTH_REFRESH_TOKEN=

# The FULL contents of the downloaded service account JSON key file, as one line.
# Still used for reading/writing the students Google Sheet (no storage needed).
GOOGLE_SERVICE_ACCOUNT_KEY=

# The id of the "Portal Students" Google Sheet shared with the service account
# (from the sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit).
GOOGLE_SHEET_ID=

# Any long, random string — used to sign session tokens. Generate one with:
# openssl rand -base64 48
SESSION_JWT_SECRET=
